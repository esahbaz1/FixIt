# ─────────────────────────────────────────────────────────────
# FixIt – environment varijable
# Kopiraj ovaj fajl: cp .env.example .env
# Popuni vrijednosti i NIKAD ne commituj .env u git!
# ─────────────────────────────────────────────────────────────

# MySQL
DB_USERNAME=fixit
DB_PASSWORD=fixit_password_2024

# RabbitMQ
RABBITMQ_USER=fixit
RABBITMQ_PASS=fixit_rabbit_2024

# JWT ključevi (RSA, base64-encoded bez line break-ova)
#
# Generisanje:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   → kopiraj u JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    → kopiraj u JWT_PUBLIC_KEY
#
JWT_PRIVATE_KEY=ZAMIJENI_SA_BASE64_PRIVATE_KEY
JWT_PUBLIC_KEY=ZAMIJENI_SA_BASE64_PUBLIC_KEY

# Interni secret između gateway-a i mikroservisa
GATEWAY_SECRET=fixit-internal-secret-2024-ZAMIJENI
